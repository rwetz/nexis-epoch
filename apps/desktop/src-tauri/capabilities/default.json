{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window chrome, the OS facts the design system reads, and the folder picker. Project files are reached only through Epoch's own commands, which confine every path to the open project; there is no general filesystem or shell permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "epoch:default",
    "os:default",
    "dialog:allow-open"
  ]
}
